##########################
###   Storage config   ###
##########################

# S3 server config - required only if you use S3 as a storage provider
# HINT: MinoIO `secret key` should be secret key length should be between 8 and 40
S3_IMAGES_BUCKET="images"
S3_AGENTS_BUCKET="agents"
S3_REGION="us-east-1"
# S3_ENDPOINT="https://minio-127-0-0-1.nip.io"
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY_ID="appuser"
S3_SECRET_ACCESS_KEY="apppassword"

############################
### Events Sync Pipeline ###
############################
QUEEN_BASE_URL=http://localhost:6632
QUEEN_TOKEN="my-jwt-token"
EVENTS_QUEUE_NAME=flow-log-events
EVENTS_QUEUE_CONSUMER_GROUP=device-access-events-sync-development
EVENTS_CONCURRENCY=5
EVENTS_MAX_PARTITIONS_PER_POP=10
EVENTS_BATCH_SIZE=100
EVENTS_RENEW_LEASE_DURATION=5000
EVENTS_SUBSCRIPTION_FROM=new
# EVENTS_SUBSCRIPTION_FROM=all
# EVENTS_SUBSCRIPTION_FROM=2026-05-01T00:00:00Z